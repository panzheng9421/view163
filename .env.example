# 访问密码（公网部署必须设置；不设置时站点会提示管理员配置后再可用）
PASSWORD=change-me

# 可选：设为 true 彻底关闭访问密码，进站即用、不弹验证框（自用/内网部署用）。
# 公网开放又不想别人用，就不要开这个。
# DISABLE_AUTH=false

# ⚠️ 必填（否则全站无内容）：预置点播源（JSON 数组），用户端自动出现且默认勾选。
# 下面是一个实测可用的示例源（Apple CMS 标准接口）；可换成你自己信任的源。
# isAdult 字段：true 表示该源含成人内容，会被服务端过滤；一般采集站填 false。
DEFAULT_SOURCES=[{"name":"bfzy","url":"https://bfzyapi.com/api.php/provide/vod","detail":"https://bfzyapi.com","isAdult":false}]

# 可选：数据源订阅（SourceList JSON 链接，一次下发点播源），也接受 TVBOX 配置地址
# DEFAULT_SUBSCRIPTIONS=["https://example.com/sources.json"]

# 可选：会话/代理签名密钥；不设置时从 PASSWORD 派生
# PROXY_SECRET=

# 可选：Cookie Secure 策略覆盖（true=强制开启 / false=强制关闭；不设置时按请求协议自动推导，HTTP 部署无需配置）
# COOKIE_SECURE=

# 可选：代理请求上游的超时与重试
REQUEST_TIMEOUT=8000
MAX_RETRIES=1

# 可选：单个搜索源的总死线（毫秒，默认 10000）。源站在境外/慢链路时可调大，如 25000
# SEARCH_SOURCE_TIMEOUT_MS=10000

# 可选：分类页单页上游超时（毫秒，默认 9000）。国内机房直连境外源常见 3~15s，可调大到 20000
# CATEGORY_PAGE_TIMEOUT_MS=9000

# 可选：搜索单页上游超时（毫秒，默认 15000）。
# SEARCH_PAGE_TIMEOUT_MS=15000

# 可选：站内采集反代（重要，国内机房常用）。
# 容器里的 Node(undici) 直连源站会被 Cloudflare 等按 TLS 指纹拦截（curl/nginx 能通、Node 秒失败）。
# 在宿主机 nginx 上开一个 /__proxy/ 反代口（见 deploy/nginx-view163.conf 的 18080 server），
# 这里填它的地址，采集接口（api.php）就会改由 nginx 的 OpenSSL 指纹去拉，媒体流不受影响。
# 用 docker compose 时容器内填 host.docker.internal，配合 compose 里的 extra_hosts。
# INGEST_PROXY_BASE=http://host.docker.internal:18080

# 可选：影视榜单推荐源（60s API）实例地址，默认官方公共实例 https://60s.viki.moe。
# 官方实例有限流（本项目每小时仅请求 6 次榜单，通常够用）；高频使用可自部署：docker run -d -p 4399:4399 vikiboss/60s:latest
# 60S_API_BASE=https://60s.viki.moe

# 可选：调试
DEBUG=false

# 可选：固定使用某个发布镜像版本（默认不设置 = ghcr.io/librespark/libretv:latest，
# 首次部署先 docker compose pull 拉取；本地开发可用 docker compose up -d --build 构建）
# LIBRETV_IMAGE=ghcr.io/librespark/libretv:2.0.1
